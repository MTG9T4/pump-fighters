+/// Converts PS2 16-bit colors (R5 G5 B5 A1, red in the low bits) to RGBA8.
+static Uint8* convert_rgb5a1_to_rgba8(const void* pixels, int count) {
+    const Uint16* src = pixels;
+    Uint8* dst = SDL_malloc(count * 4);
+
+    for (int i = 0; i < count; i++) {
+        const Uint16 c = src[i];
+        const Uint8 r = c & 0x1F;
+        const Uint8 g = (c >> 5) & 0x1F;
+        const Uint8 b = (c >> 10) & 0x1F;
+        dst[i * 4 + 0] = (r << 3) | (r >> 2);
+        dst[i * 4 + 1] = (g << 3) | (g >> 2);
+        dst[i * 4 + 2] = (b << 3) | (b >> 2);
+        dst[i * 4 + 3] = (c & 0x8000) ? 0xFF : 0;
+    }
+
+    return dst;
+}
+
+/// Converts BGRA8 to RGBA8.
+static Uint8* convert_bgra8_to_rgba8(const void* pixels, int count) {
+    const Uint8* src = pixels;
+    Uint8* dst = SDL_malloc(count * 4);
+
+    for (int i = 0; i < count; i++) {
+        dst[i * 4 + 0] = src[i * 4 + 2];
+        dst[i * 4 + 1] = src[i * 4 + 1];
+        dst[i * 4 + 2] = src[i * 4 + 0];
+        dst[i * 4 + 3] = src[i * 4 + 3];
+    }
+
+    return dst;
+}
+#endif
