diff --git a/src/platform/web/web_bridge.c b/src/platform/web/web_bridge.c
new file mode 100644
index 00000000..5712b67d
--- /dev/null
+++ b/src/platform/web/web_bridge.c
@@ -0,0 +1,40 @@
+#ifdef __EMSCRIPTEN__
+
+#include "platform/web/web_bridge.h"
+
+#include <emscripten.h>
+
+// `Module.pcAfs` is provided by the page (pumpcombat/web/src/afs-store.js).
+
+EM_JS(uint32_t, Web_AFS_Size, (void), { return Module['pcAfs'].size() >>> 0; });
+
+EM_JS(int, Web_AFS_ReadSync, (uint32_t offset, void* dst, uint32_t len), {
+    return Module['pcAfs'].readSync(offset >>> 0, len >>> 0, HEAPU8, dst >>> 0);
+});
+
+EM_JS(bool, Web_AFS_IsResident, (uint32_t offset, uint32_t len), {
+    return Module['pcAfs'].isResident(offset >>> 0, len >>> 0) ? 1 : 0;
+});
+
+EM_JS(void, Web_AFS_FetchStart, (int token, uint32_t offset, uint32_t len), {
+    Module['pcAfs'].fetchStart(token, offset >>> 0, len >>> 0);
+});
+
+EM_JS(int, Web_AFS_FetchPoll, (int token, void* dst, uint32_t len), {
+    return Module['pcAfs'].fetchPoll(token, HEAPU8, dst >>> 0, len >>> 0);
+});
+
+EM_JS(void, Web_AFS_FetchCancel, (int token), { Module['pcAfs'].fetchCancel(token); });
+
+EM_JS(void, Web_NotifyGameStarted, (void), {
+    if (Module['onGameStarted']) {
+        Module['onGameStarted']();
+    }
+});
+
+/// Current wasm heap size in bytes (for the page's debug overlay).
+EMSCRIPTEN_KEEPALIVE uint32_t Web_GetHeapUsage(void) {
+    return (uint32_t)EM_ASM_INT({ return HEAPU8.length; });
+}
+
+#endif
diff --git a/src/platform/web/web_bridge.h b/src/platform/web/web_bridge.h
new file mode 100644
index 00000000..6624ae01
--- /dev/null
+++ b/src/platform/web/web_bridge.h
@@ -0,0 +1,42 @@
+#ifndef PLATFORM_WEB_BRIDGE_H
+#define PLATFORM_WEB_BRIDGE_H
+
+// Glue between the game and the PUMP FIGHTERS web page (pumpcombat/web).
+//
+// The page patches the player's own SF33RD.AFS once, keeps it in the browser's own storage (OPFS) and
+// exposes it as `Module.pcAfs`. Small entries (everything but the .adx music) plus the AFS
+// header and attribute table are copied into JS memory, so the game can read them synchronously.
+// The .adx music streams are read on demand from the stored file, asynchronously.
+
+#ifdef __EMSCRIPTEN__
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/// Total size of the AFS archive in bytes.
+uint32_t Web_AFS_Size(void);
+
+/// Reads `len` bytes at `offset` into `dst` from the resident copy.
+/// @return Number of bytes copied, or -1 if the range is not resident.
+int Web_AFS_ReadSync(uint32_t offset, void* dst, uint32_t len);
+
+/// @return Whether the whole range is resident (can be read with `Web_AFS_ReadSync`).
+bool Web_AFS_IsResident(uint32_t offset, uint32_t len);
+
+/// Starts an asynchronous read of a range that is not resident.
+void Web_AFS_FetchStart(int token, uint32_t offset, uint32_t len);
+
+/// Polls an asynchronous read. When it has finished the data is copied to `dst`.
+/// @return 1 when done (data copied), 0 while pending, -1 on error.
+int Web_AFS_FetchPoll(int token, void* dst, uint32_t len);
+
+/// Drops an asynchronous read that is no longer needed.
+void Web_AFS_FetchCancel(int token);
+
+/// Tells the page the game has started (hides the loader).
+void Web_NotifyGameStarted(void);
+
+#endif
+
+#endif
diff --git a/src/platform/web/web_rom_stub.c b/src/platform/web/web_rom_stub.c
