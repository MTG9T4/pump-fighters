@@ -0,0 +1,44 @@
+#ifdef __EMSCRIPTEN__
+
+// The web build has no CPS3 ROM zips (and no minizip-ng), so arcade/rom/rom.c is replaced by
+// these stubs. Arcade_Init only calls Rom_Create when a zip exists, which never happens here.
+
+#include "arcade/rom/rom.h"
+
+const char* Rom_GetZipName(RomGame game) {
+    return (game == ROM_GAME_SFIII) ? "sfiii.zip" : "sfiii3.zip";
+}
+
+Rom* Rom_Create(RomGame game, const char* path) {
+    (void)game;
+    (void)path;
+    SDL_SetError("CPS3 ROMs are not supported in the web build");
+    return NULL;
+}
+
+void Rom_Destroy(Rom* rom) {
+    (void)rom;
+}
+
+RomGame Rom_GetGame(const Rom* rom) {
+    (void)rom;
+    return ROM_GAME_SFIII3;
+}
+
+RomRegion Rom_GetSimm(const Rom* rom, int simm) {
+    (void)rom;
+    (void)simm;
+    return (RomRegion) { 0 };
+}
+
+RomRegion Rom_GetProgram(const Rom* rom) {
+    (void)rom;
+    return (RomRegion) { 0 };
+}
+
+RomRegion Rom_GetGraphics(const Rom* rom) {
+    (void)rom;
+    return (RomRegion) { 0 };
+}
+
+#endif
