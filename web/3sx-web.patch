@@ -467,10 +495,53 @@ SDL_AppResult SDL_AppIterate(void* appstate) {
     }
 
     if (phase == APP_PHASE_INITIALIZED) {
+#ifdef __EMSCRIPTEN__
+        // requestAnimationFrame runs at the display rate (60, 90, 120 Hz, or 30 Hz in low power mode).
+        // Step the game at ~60 Hz: skip callbacks that come too early and run up to two frames
+        // when the display is slower. The accumulator never goes below zero, so a 60 Hz display
+        // runs exactly one game frame per callback instead of drifting against 59.6 Hz.
+        static Uint64 web_last_tick = 0;
+        static Sint64 web_accumulator = 0;
+        const Uint64 now = SDL_GetTicksNS();
+
+        if (web_paused && web_last_tick != 0) {
+            web_last_tick = now;
+            web_accumulator = 0;
+            return SDL_APP_CONTINUE;
+        }
+
+        if (web_last_tick == 0) {
+            web_last_tick = now - target_frame_time_ns;
+            Web_NotifyGameStarted();
+        }
+
+        web_accumulator += (Sint64)(now - web_last_tick);
+        web_last_tick = now;
+
+        if (web_accumulator > (Sint64)(4 * target_frame_time_ns)) {
+            // The tab was in the background or stalled: don't fast-forward
+            web_accumulator = target_frame_time_ns;
+        }
+
+        const Sint64 early_tolerance = target_frame_time_ns / 10;
+
+        for (int steps = 0; (steps < 2) && (web_accumulator + early_tolerance >= (Sint64)target_frame_time_ns); steps++) {
+            begin_frame();
+            Main_StepFrame();
+            end_frame();
+            Main_FinishFrame();
+            web_accumulator -= target_frame_time_ns;
+        }
+
+        if (web_accumulator < 0) {
+            web_accumulator = 0;
+        }
+#else
         begin_frame();
         Main_StepFrame();
         end_frame();
         Main_FinishFrame();
+#endif
     }
 
     return SDL_APP_CONTINUE;
