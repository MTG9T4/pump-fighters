// PUMP FIGHTERS web build as a static site (../dist) on Cloudflare Workers.
// Run in web/worker after `bash web/build.sh`, then `npx wrangler deploy`.
// Set "name" to your own Worker name. To serve it on your own domain, add a "routes" entry, e.g.
//   "routes": [{ "pattern": "fighters.example.com", "custom_domain": true }]
// Without routes it is served on your workers.dev subdomain.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pump-fighters",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
